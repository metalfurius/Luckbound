+        private static void AssertTextMetrics(Text text, string content, bool wrapped)
+        {
+            Canvas.ForceUpdateCanvases();
+            RectTransform rect = text.rectTransform;
+            Vector2 extents = rect.rect.size;
+            TextGenerationSettings settings = text.GetGenerationSettings(extents);
+            var generator = new TextGenerator();
+            generator.Populate(content, settings);
+            float pixelsPerUnit = text.pixelsPerUnit;
+            Assert.That(pixelsPerUnit, Is.GreaterThan(0f), text.name + " pixels-per-unit scale");
+            float preferredWidth = generator.GetPreferredWidth(content, settings) / pixelsPerUnit;
+            float preferredHeight = generator.GetPreferredHeight(content, settings) / pixelsPerUnit;
+            var visibleGenerator = new TextGenerator();
+            visibleGenerator.Populate(content, settings);
+            int visibleCharacters = content.Count(character => character != '\n' && character != '\r');
+            var metric = new HubTextMetric
+            {
+                name = text.name,
+                content = content,
+                fontName = text.font == null ? string.Empty : text.font.name,
+                fontSize = text.fontSize,
+                anchoredX = rect.anchoredPosition.x,
+                anchoredY = rect.anchoredPosition.y,
+                rectWidth = extents.x,
+                rectHeight = extents.y,
+                pixelsPerUnit = pixelsPerUnit,
+                preferredWidth = preferredWidth,
+                preferredHeight = preferredHeight,
+                visibleCharacterCount = visibleGenerator.characterCountVisible,
+                expectedVisibleCharacterCount = visibleCharacters
+            };
+            Debug.Log("[E10.HUB.PRIMARY.TEXT-METRIC] " + JsonUtility.ToJson(metric));
+            if (!wrapped)
+                Assert.That(preferredWidth, Is.LessThanOrEqualTo(extents.x + 0.5f),
+                    text.name + " preferred width must fit its existing rect.");
+            Assert.That(preferredHeight, Is.LessThanOrEqualTo(extents.y + 0.5f),
+                text.name + " preferred height must fit its existing rect.");
+            Assert.That(visibleGenerator.characterCountVisible, Is.GreaterThanOrEqualTo(visibleCharacters),
+                text.name + " must display every authored character with its existing overflow mode.");
+        }
